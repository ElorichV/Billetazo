# Configuración del servidor local y API de Pey (https://portal.mipey.mx / https://docs.pey.mx)
HOST=127.0.0.1
PORT=3000
PEY_API_BASE_URL=https://api.pey.mx
# Pega aquí tu API Key de portal.mipey.mx para activar cobros reales de $0.01 MXN
PEY_API_KEY=
# Secreto de Standard Webhooks (ej. whsec_...) configurado en portal.mipey.mx
PEY_WEBHOOK_SECRET=
# ID opcional de la cuenta bancaria activa en Pey (ULID)
PEY_DEFAULT_BANK_ACCOUNT_ID=
# Token para rutas de simulación y configuración (cabecera x-admin-token). Obligatorio para usarlas en producción.
PEYOS_ADMIN_TOKEN=
